# =============================================================================
# SERVER
# =============================================================================

PORT=3100

# =============================================================================
# PATHS
# =============================================================================
# Оставь пустым — бэкенд определяет root автоматически (ищет go.mod вверх по дереву).
# Заполни только если запускаешь бинарь из нестандартного места.

ROOT_DIR=

# Каталог .ai/ активного проекта (абсолютный путь).
# Если задан — открывается автоматически при старте.
AI_DIR=

# Каталог poligons/ относительно ROOT_DIR.
# Если пусто — берётся <ROOT_DIR>/poligons.
POLIGONS_DIR=

# =============================================================================
# LLM PROVIDER
# =============================================================================
#   claude    — Anthropic Claude  (нужен ANTHROPIC_API_KEY)
#   codex     — OpenAI GPT        (нужен OPENAI_API_KEY)
#   deepseek  — DeepSeek          (нужен DEEPSEEK_API_KEY)
#   gemini    — Google Gemini     (нужен GEMINI_API_KEY)

LLM_PROVIDER=claude

# =============================================================================
# API KEYS
# =============================================================================

# Claude — https://console.anthropic.com/keys
ANTHROPIC_API_KEY=

# OpenAI / Codex — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# =============================================================================
# MODEL OVERRIDES (необязательно)
# =============================================================================
# Если не заполнено — используются дефолты:
#   claude   → claude-sonnet-4-6
#   codex    → gpt-4o
#   deepseek → deepseek-chat
#   gemini   → gemini-2.0-flash

# ANTHROPIC_MODEL=claude-sonnet-4-6
# OPENAI_MODEL=gpt-4o
# DEEPSEEK_MODEL=deepseek-chat
# GEMINI_MODEL=gemini-2.0-flash
