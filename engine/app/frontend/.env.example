# =============================================================================
# BACKEND CONNECTION (web-mode, без Tauri)
# =============================================================================
# В dev-режиме (npm run dev) Vite-proxy уже форвардит /api и /ws на бэкенд,
# поэтому эти переменные нужны только для prod-билда (npm run build).

VITE_BACKEND_URL=http://localhost:3100
VITE_WS_URL=ws://localhost:3100/ws

# =============================================================================
# APP
# =============================================================================

VITE_APP_TITLE=Harvester
