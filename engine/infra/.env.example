# =============================================================================
# PROJECT
# =============================================================================
# Окружение: development | production

APP_ENV=development

# Порт HTTP/WebSocket сервера. По умолчанию 3100
# (app/backend/internal/constants/env.go).

PORT=3100

# =============================================================================
# LLM PROVIDER
# =============================================================================
# Выбери одного провайдера: claude | codex | deepseek | gemini.
# Заполнять нужно только ключ выбранного провайдера.

LLM_PROVIDER=claude

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# Модели по умолчанию переопределять не обязательно:
# ANTHROPIC_MODEL=claude-sonnet-4-6
# OPENAI_MODEL=gpt-4o
# DEEPSEEK_MODEL=deepseek-chat
# GEMINI_MODEL=gemini-2.0-flash
