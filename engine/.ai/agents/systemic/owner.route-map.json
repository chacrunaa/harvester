      "condition": "has-answers"
    },
    {
      "name": "recommendation",
      "path": ".ai/chats/systemic/owner/recommendation.md",
      "required": false
    },
    {
      "name": "tech-proposal",
      "path": ".ai/chats/systemic/owner/tech-proposal.md",
